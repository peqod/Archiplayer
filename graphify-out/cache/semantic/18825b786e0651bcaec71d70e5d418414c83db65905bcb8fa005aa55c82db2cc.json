{"nodes": [{"id": "release_tag_driven_process", "label": "Tag-driven release process", "file_type": "rationale", "source_file": "RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pushing a vX.Y.Z tag is the only correct release trigger; gh release create is forbidden because it creates the tag and pre-publishes a release that collides with what CI produces (this is how v0.3.0 got cut Windows-only by hand and had to be backfilled by CI)"}, {"id": "release_draft_release_gate", "label": "Draft release review gate", "file_type": "rationale", "source_file": "RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Releases start as drafts and stay invisible to the website (which reads releases/latest, excluding drafts) until a human verifies all assets and publishes; if any platform leg fails, checksums is skipped and the partial draft must not be published"}, {"id": "release_asset_name_contract", "label": "Release asset-name contract", "file_type": "rationale", "source_file": "RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "site/site.js matches release assets by regex (Windows /setup.*\\.exe$|\\.msi$/i, macOS /\\.dmg$/i, checksums /SHA256SUMS/i), so the build outputs must never be renamed or the site download buttons break; Linux has no matcher and is shown as coming soon"}, {"id": "release_reproducibility_stance", "label": "Repeatable-process reproducibility", "file_type": "rationale", "source_file": "RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundles are not byte-for-byte reproducible because NSIS and dmg embed timestamps and packaging metadata; reproducibility here means a repeatable process with pinned inputs (package-lock.json, Cargo.lock with --locked, Node 22, Rust stable, pinned actions) yielding functionally equivalent builds - byte-identical output is explicitly out of scope"}, {"id": "release_virustotal_verification", "label": "VirusTotal verification step", "file_type": "concept", "source_file": "RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_release_script", "label": "scripts/release.ps1 one-command release", "file_type": "code", "source_file": "RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automates check preconditions, version bump, version gate, release commit, push, confirmed tag push, CI watch, asset verification, and draft publish; the confirmation prompt before the tag push is the point of no return"}, {"id": "site_site_asset_matchers", "label": "site.js release asset matchers", "file_type": "code", "source_file": "RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "release_tag_driven_process", "target": "_github_workflows_release_release_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "release_tag_driven_process", "target": "scripts_release_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "scripts_release_script", "target": "scripts_verify_release_version_version_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "release_draft_release_gate", "target": "_github_workflows_release_release_workflow", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "release_draft_release_gate", "target": "site_site_asset_matchers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "release_asset_name_contract", "target": "site_site_asset_matchers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "release_reproducibility_stance", "target": "_github_workflows_release_release_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "release_virustotal_verification", "target": "site_index_landing_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "release_pipeline", "label": "Tag-to-published-release pipeline", "nodes": ["release_tag_driven_process", "scripts_release_script", "scripts_verify_release_version_version_gate", "_github_workflows_release_release_workflow", "_github_workflows_release_publish_job", "_github_workflows_release_checksums_job", "release_draft_release_gate"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE.md"}, {"id": "unsigned_build_trust_chain", "label": "Unsigned build trust and verification chain", "nodes": ["readme_unsigned_builds", "_github_workflows_release_checksums_job", "release_virustotal_verification", "site_index_landing_page"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "RELEASE.md"}]}