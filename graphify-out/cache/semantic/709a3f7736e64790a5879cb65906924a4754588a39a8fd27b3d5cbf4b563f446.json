{"nodes": [{"id": "readme_archiplayer", "label": "Archiplayer", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_local_first_architecture", "label": "Local-first architecture", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No login, no cloud: all personal data (library, favourites, history, settings) stays in a local SQLite database in the OS app-data directory for org.archiplayer.app; nothing is synchronized or uploaded"}, {"id": "readme_wfmu_polite_fetch_policy", "label": "WFMU polite cache-first fetch policy", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WFMU exposes no official archive API, so Archiplayer parses public KenzoDB pages on demand at a strict one-request-per-second global rate, caches results instead of crawling, refreshes the A-Z index at most daily, refreshes a show page only after six hours, and offers no bulk audio download - to avoid burdening a listener-supported non-commercial station"}, {"id": "readme_kenzodb_parsing", "label": "KenzoDB page parsing", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tech_stack", "label": "Rust + Tauri 2 + Svelte 5 stack", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_unsigned_builds", "label": "Unsigned release builds", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Community builds are unsigned, so Windows SmartScreen and macOS Gatekeeper warn on open; users are told to verify the SHA-256 hash against SHA256SUMS.txt or build from source instead of trusting the binary blindly"}, {"id": "readme_build_from_source", "label": "Build-from-source instructions", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sqlite_library", "label": "Local SQLite library (library.db)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_live_smoke_test", "label": "Ignored live WFMU smoke test", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ignored by default because it performs live network requests against WFMU; run sparingly, only when working on the WFMU integration, and never in a loop"}, {"id": "build_env_script", "label": "build-env.ps1 MSVC environment helper", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dot-sourced helper that selects stable-x86_64-pc-windows-msvc, discovers Visual Studio Build Tools, and loads link.exe plus the Windows SDK into the shell without changing the rustup default"}], "edges": [{"source": "readme_archiplayer", "target": "readme_local_first_architecture", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_archiplayer", "target": "readme_tech_stack", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme