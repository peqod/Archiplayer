{"nodes": [{"id": "docs_styling_css_variable_presets", "label": "CSS variable sizing presets", "file_type": "rationale", "source_file": "docs/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Size/spacing presets (--icon-size, --pbtn-size, --pbtn-main-size, --pctl-gap, --player-gap) live once in :root next to the --c-* colour tokens so one edit applies globally, while the CSS cascade lets any element or modifier class override the same variable locally - nearest value wins"}, {"id": "docs_styling_global_svg_piercing", "label": ":global() icon piercing pattern", "file_type": "rationale", "source_file": "docs/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Svelte scoped CSS cannot reach into a child component's SVG, so a plain .pbtn.main svg selector does nothing; the pattern pierces with :global(svg.icon) kept under the scoped parent selector so it hits only that button"}, {"id": "src_lib_icon_icon", "label": "Icon.svelte component", "file_type": "code", "source_file": "docs/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_routes__layout_root_tokens", "label": "+layout.svelte :root design tokens", "file_type": "code", "source_file": "docs/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_styling_css_variable_presets", "target": "src_routes__layout_root_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/styling.md", "source_location": null, "weight": 1.0}, {"source": "docs_styling_css_variable_presets", "target": "src_lib_icon_icon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/styling.md", "source_location": null, "weight": 1.0